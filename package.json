{
    "name": "utunoya",
    "displayName": "Utunoya",
    "description": "A live manuscript-style preview for Visual Studio Code",
    "version": "0.1.7",
    "publisher": "ieremius",
    "repository": {
        "type": "git",
        "url": "https://github.com/ieremi/utunoya.git"
    },
    "license": "MIT",
    "engines": {
        "vscode": "^1.90.0"
    },
    "categories": [
        "Other"
    ],
    "keywords": [
        "manuscript",
        "preview",
        "writing",
        "Japanese",
        "genko",
        "character count"
    ],
    "activationEvents": [
        "onCommand:utunoya.open"
    ],
    "main": "./out/extension.js",
    "contributes": {
        "commands": [
            {
                "command": "utunoya.open",
                "title": "Open Utunoya Preview",
                "category": "Utunoya",
                "icon": "$(open-preview)"
            }
        ],
        "viewsContainers": {
            "activitybar": [
                {
                    "id": "utunoya",
                    "title": "Utunoya",
                    "icon": "media/icon.svg"
                }
            ]
        },
        "views": {
            "utunoya": [
                {
                    "id": "utunoya.view",
                    "name": "Preview"
                }
            ]
        },
        "viewsWelcome": [
            {
                "view": "utunoya.view",
                "contents": "The manuscript preview is open while this panel is shown. Click the Utunoya icon again, or switch to another panel, to close it."
            }
        ],
        "menus": {
            "editor/title": [
                {
                    "command": "utunoya.open",
                    "when": "editorLangId != '' && resourceScheme != 'utunoya-preview'",
                    "group": "navigation"
                }
            ]
        }
    },
    "scripts": {
        "compile": "tsc -p .",
        "watch": "tsc --watch -p .",
        "package": "npm run compile && vsce package --allow-missing-repository",
        "publish": "npm run compile && vsce publish --azure-credential --allow-missing-repository"
    },
    "devDependencies": {
        "@types/vscode": "^1.90.0",
        "@vscode/vsce": "^3.6.0",
        "typescript": "^5.9.0"
    }
}